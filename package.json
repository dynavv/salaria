{
  "name": "personal-finance-app",
  "version": "1.0.0",
  "description": "Personal Finance Management App with Telegram HTML Import & Multi-Month Analytics",
  "license": "GPL-3.0-or-later",
  "main": "backend/src/index.ts",
  "scripts": {
    "server": "tsx watch backend/src/index.ts",
    "client": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build:client": "npm --prefix frontend run build",
    "start": "tsx backend/src/index.ts"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "better-sqlite3": "^11.8.1",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
