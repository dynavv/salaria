# Server Port (Mặc định: 5000)
PORT=5000
NODE_ENV=development

# Cloudflare D1 Edge Worker Sync Configuration
D1_WORKER_URL=https://salaria.your-subdomain.workers.dev
D1_API_KEY=your_secret_api_key_here

# Telegram Bot Token (Tùy chọn nếu cấu hình sync local)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

