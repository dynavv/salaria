# Gemini AI API Configuration (Lấy từ Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Server Port (Mặc định: 3001)
PORT=3001

# Google Sheet Web App Deployment URL (Tùy chọn, có thể cấu hình trực tiếp qua giao diện Web)
# GOOGLE_SHEET_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
