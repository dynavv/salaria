{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salaria-vault",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "30 15 * * *"
    ]
  },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salarini-db",
      "database_id": "784a5443-5e36-4732-8bbe-603ac80129ae"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "AI_ADVISOR_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "API_KEY": "sal_sec_demo_key_2026",
    "MASTER_PIN": "112358"
  }
}
