{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salaria",
  "main": "cloudflare_worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salarini-db",
      "database_id": "784a5443-5e36-4732-8bbe-603ac80129ae"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.2-3b-instruct",
    "API_KEY": "salaria_secret_2026"
  }
}
