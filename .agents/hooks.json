{
  "safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/safety_guard.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "salarini-reminder": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 scripts/pre_invocation_reminder.py",
        "timeout": 10
      }
    ]
  }
}
